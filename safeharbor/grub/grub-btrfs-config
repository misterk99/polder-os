# Polder SafeHarbor overrides for the vendored grub-btrfs (sourced after its own /etc/default/grub-btrfs/config defaults)
GRUB_BTRFS_SUBMENUNAME="Polder OS — eerdere versies (SafeHarbor)"
GRUB_BTRFS_TITLE_FORMAT=("date" "snapshot" "description")
GRUB_BTRFS_LIMIT="20"
GRUB_BTRFS_SHOW_SNAPSHOTS_FOUND="true"
GRUB_BTRFS_IGNORE_SPECIFIC_PATH=("@")
GRUB_BTRFS_IGNORE_PREFIX_PATH=("@rollback-" "@new-")
GRUB_BTRFS_SNAPSHOT_KERNEL_PARAMETERS="polder.safeharbor=snapshot"
