# --- backgrounds (must come first) ---
# 1 panel: surface
rounded = 0
border_width = 0
background_color = #f8f9fc 100
border_color = #000000 0
# 2 task button
rounded = 20
border_width = 0
background_color = #ffffff 0
border_color = #000000 0
background_color_hover = #e8eef7 100
# 3 active task
rounded = 20
border_width = 0
background_color = #d3e3fd 100
border_color = #000000 0
# 4 status pill
rounded = 18
border_width = 0
background_color = #e8eef7 100
border_color = #000000 0

# ChromeOS-style shelf: launcher left, pinned apps + tasks centered, status right
panel_items = LT
panel_size = 0 52
panel_shrink = 1
panel_margin = 0 0
panel_padding = 8 6 8
panel_position = bottom center horizontal
panel_layer = top
panel_background_id = 1
font_shadow = 0

launcher_padding = 6 4 10
launcher_background_id = 0
launcher_icon_size = 34
launcher_icon_theme = Papirus
launcher_item_app = /usr/share/applications/chromium.desktop
launcher_item_app = /usr/share/applications/xfce4-terminal.desktop
launcher_item_app = /workspace/osbuilder/config/files/files.desktop

taskbar_mode = single_desktop
taskbar_padding = 0 0 4
taskbar_background_id = 0
taskbar_name = 0
task_icon = 1
task_text = 0
task_centered = 1
task_maximum_size = 44 44
task_padding = 4 4 4
task_background_id = 2
task_active_background_id = 3

