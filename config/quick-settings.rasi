* { font: "Roboto 12"; background-color: transparent; text-color: #e8eaed; }
window { width: 340px; location: south east; anchor: south east; x-offset: -10px; y-offset: -62px; background-color: #2b2c2f; border-radius: 0px; padding: 16px; }
inputbar { children: [prompt]; padding: 4px 6px 12px 6px; }
prompt { font: "Roboto Medium 13"; }
listview { lines: 8; spacing: 6px; }
element { padding: 10px 14px; border-radius: 18px; background-color: #3c4043; }
element selected { background-color: #8ab4f8; text-color: #202124; }
element-text { text-color: inherit; }
